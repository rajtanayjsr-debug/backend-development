<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= pageTitle %> - Simple CMS</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>
    <header class="site-header">
        <div class="container header-container">
            <h1 class="logo"><a href="/posts">Simple CMS</a></h1>
            <nav>
                <a href="/posts" class="btn btn-secondary">&larr; Back to Posts</a>
            </nav>
        </div>
    </header>

    <main class="container main-content">
        <section class="form-container">
            <h2>Create a New Post</h2>

            <% if (errorMessage) { %>
                <div class="alert alert-error">
                    <%= errorMessage %>
                </div>
            <% } %>

            <form action="/posts" method="POST" class="post-form">
                <div class="form-group">
                    <label for="title">Title *</label>
                    <input 
                        type="text" 
                        id="title" 
                        name="title" 
                        value="<%= formData.title %>" 
                        placeholder="Enter post title" 
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="author">Author *</label>
                    <input 
                        type="text" 
                        id="author" 
                        name="author" 
                        value="<%= formData.author %>" 
                        placeholder="Enter author's name" 
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="content">Content *</label>
                    <textarea 
                        id="content" 
                        name="content" 
                        rows="8" 
                        placeholder="Write your blog post content here..." 
                        required
                    ><%= formData.content %></textarea>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn btn-primary">Publish Post</button>
                    <a href="/posts" class="btn btn-cancel">Cancel</a>
                </div>
            </form>
        </section>
    </main>

    <footer class="site-footer">
        <div class="container">
            <p>&copy; <%= new Date().getFullYear() %> Simple CMS - Backend Development Lab</p>
        </div>
    </footer>
</body>
</html>
